# Local dev config — copied to .env.local by `make dev`. NOT for the server;
# production config lives in .env and is never read by the Makefile targets.
#
# The defaults below need no Navidrome, no Home Assistant and no cast devices:
# `make seed` builds ./devdata/quiz.db plus ./devclips of ffmpeg tones, and the
# app plays those. Fill in the optional blocks only when you're testing the
# integration that needs them.

# Dev paths, overriding the container's /data and /clips (app/config.py).
QUIZ_DB=./devdata/quiz.db
CLIPS_DIR=./devclips

# Never cast to real TVs/speakers from a dev run — flip to true deliberately.
CAST_ENABLED=false

# Seeded tracks are pre-tiered and pre-clipped, so no startup sweep is needed.
CLIP_SWEEP_ON_START=false

# Leave the admin page open locally; the production password lives in .env.
#ADMIN_PASSWORD=

# --- optional: talk to the real Navidrome (sync/scoring/clip-cutting) ---
# Read-only as far as Navidrome is concerned, but it will fetch real audio.
# Copy the values from .env if you need them.
#NAVIDROME_URL=
#NAVIDROME_USER=
#NAVIDROME_PASSWORD=
#LASTFM_API_KEY=

# --- optional: talk to the real Home Assistant (speaker list, grouping) ---
# HA has to reach APP_BASE_URL to fetch a clip, so plain localhost won't do:
# use your Mac's LAN address here.
#HA_URL=
#HA_TOKEN=
#MEDIA_PLAYER=
#APP_BASE_URL=http://192.168.1.x:8000
